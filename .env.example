# ID do contêiner do Google Tag Manager (GTM-XXXXXXX). Vazio = nenhum script de terceiros carrega.
PUBLIC_GTM_ID=
# URL do Worker que recebe o formulário e grava no banco (ver docs/BACKEND.md).
# Ex.: https://montamoveissp-leads.SEU-SUBDOMINIO.workers.dev/lead
# Vazio = o formulário só abre o WhatsApp, sem gravar nada.
PUBLIC_LEAD_ENDPOINT=
# URL pública do site. Em produção com domínio próprio: https://www.montamoveissp.com.br
PUBLIC_SITE_URL=https://www.montamoveissp.com.br
# Caminho base. "/" com domínio próprio. "/montamoveissp" enquanto estiver em murilomrm.github.io/montamoveissp
BASE_PATH=/
# "1" coloca noindex em todas as páginas (usado no deploy provisório em github.io)
PUBLIC_NOINDEX_ALL=
# "1" mostra depoimentos placeholder no dev local. Proibido em CI.
ALLOW_PLACEHOLDERS=
