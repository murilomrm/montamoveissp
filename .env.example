# Em produção estas variáveis são definidas no painel:
# Cloudflare Pages > Projeto > Settings > Environment variables (escopos Production e Preview separados).
# Este arquivo é só um modelo para desenvolvimento local. Copie para .env, que nunca é commitado.

# Token do Cloudflare Web Analytics. Pegue em Cloudflare > Analytics & Logs > Web Analytics.
# Vazio = nenhum script de medição carrega. Sem cookie, não exige banner.
PUBLIC_CF_ANALYTICS_TOKEN=

# ID do contêiner do Google Tag Manager (GTM-XXXXXXX). Vazio = nenhum script de terceiros carrega.
PUBLIC_GTM_ID=

# URL do Worker que recebe o formulário e grava no banco (ver docs/BACKEND.md).
# Só é usada quando site.formularioAtivo for true. Vazio = o formulário só abre o WhatsApp.
PUBLIC_LEAD_ENDPOINT=

# URL pública do site. O Cloudflare Pages usa esta variável para montar canonical e sitemap.
PUBLIC_SITE_URL=https://www.montamoveissp.com.br

# "1" força noindex em todas as páginas. Deploy de preview já sai com noindex sozinho.
PUBLIC_NOINDEX_ALL=

# "1" mostra depoimentos placeholder no dev local. Proibido em produção.
ALLOW_PLACEHOLDERS=
