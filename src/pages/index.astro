---
import Base from "@/layouts/Base.astro";
import { site } from "@/data/site";
import { servicos } from "@/data/servicos";
import { faqGeral } from "@/data/faq";
import { paginas } from "@/data/paginas";
import { regioesPrioridade1 } from "@/lib/regioes";
import { schemaFaq } from "@/lib/seo";
import { href } from "@/lib/url";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import Provas from "@/components/Provas.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import RegionGrid from "@/components/RegionGrid.astro";
import Steps from "@/components/Steps.astro";
import Testimonials from "@/components/Testimonials.astro";
import FAQ from "@/components/FAQ.astro";
import LeadForm from "@/components/LeadForm.astro";
import CTAFinal from "@/components/CTAFinal.astro";
import Foto from "@/components/Foto.astro";
import Trena from "@/components/Trena.astro";
import Conversa from "@/components/Conversa.astro";
import GaleriaFiltro from "@/components/GaleriaFiltro.astro";
import HeroCarrossel from "@/components/HeroCarrossel.astro";
import Curadoria from "@/components/Curadoria.astro";

// Planejados e escritório primeiro: são os serviços de maior valor.
const porSlug = (slug: string) => servicos.find((s) => s.slug === slug)!;
const destaques = [
  { servico: porSlug("montagem-de-moveis-planejados"), foto: "real-cozinha-granito", alt: "Cozinha planejada branca com bancada de granito e iluminação embutida" },
  { servico: porSlug("mudanca-de-escritorio"), foto: "real-estante-escritorio", alt: "Estante de ferro preto com prateleiras e gaveteiro em madeira" },
];
const demais = servicos.filter((s) => !destaques.some((d) => d.servico.slug === s.slug));


---
<Base title={paginas.home.title} description={paginas.home.description} path="/" tipoPagina="home" schemas={[schemaFaq(faqGeral)]}>
  <section class="bg-cinza">
    <div class="container-site grid gap-x-12 gap-y-8 pt-10 pb-12 md:grid-cols-[1.1fr_1fr] md:grid-rows-[auto_1fr] md:pt-16 md:pb-16">
      <div>
        <h1 class="mb-5 max-w-[14ch]">Montador de móveis e planejados em São Paulo</h1>
        <p class="mb-7 max-w-[40ch] text-xl leading-snug"><strong class="font-semibold text-primaria">Mande fotos pelo WhatsApp.</strong> Receba o valor fechado. Só agende se aprovar.</p>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
          <WhatsAppButton origem="hero" class="text-lg" />
          {site.exibirValorMinimo && <span class="text-cinza-medio">Serviços a partir de R$ {site.valorMinimo}</span>}
        </div>
      </div>
      <div class="md:row-span-2"><HeroCarrossel /></div>
      <div class="md:self-start"><Provas /></div>
    </div>
    <Trena />
  </section>

  <section id="servicos" class="secao scroll-mt-20" aria-labelledby="servicos-titulo">
    <div class="container-site">
      <h2 id="servicos-titulo" class="mb-3">O que montamos</h2>
      <p class="mb-10 max-w-[60ch] text-cinza-medio">Do móvel que chegou na caixa ao planejado da marcenaria. Cada serviço tem página com o que está incluso e o tempo médio.</p>

      <div class="mb-6 grid gap-6 md:grid-cols-2">
        {destaques.map((d) => (
          <a href={href(`/${d.servico.slug}/`)} class="group block">
            <Foto nome={d.foto} alt={d.alt} classeImg="aspect-[3/2]" />
            <h3 class="mt-4 mb-1 text-2xl group-hover:underline group-hover:decoration-acao group-hover:decoration-4 group-hover:underline-offset-4">{d.servico.nome}</h3>
            <p class="text-cinza-medio">{d.servico.resumo}</p>
          </a>
        ))}
      </div>

      <div class="grid border-t border-gray-300 md:grid-cols-2 md:gap-x-10">
        {demais.map((s) => <ServiceCard servico={s} />)}
      </div>
    </div>
  </section>

  <section id="trabalhos" class="secao scroll-mt-20 bg-cinza" aria-labelledby="trabalhos-titulo">
    <div class="container-site">
      <h2 id="trabalhos-titulo" class="mb-3">Trabalhos de montadores da rede</h2>
      <p class="mb-6 max-w-[60ch] text-cinza-medio">Fotos tiradas no dia da montagem, sem edição. Escolha o tipo de serviço:</p>
      <GaleriaFiltro />
      {site.instagram && (
        <p class="mt-8 text-cinza-medio">
          Mais trabalhos e dicas no Instagram:
          <a href={site.instagram} rel="noopener" target="_blank" class="ml-1 inline-flex items-center gap-1.5 font-semibold text-primaria underline decoration-acao decoration-2 underline-offset-4">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            {site.instagramUsuario}
          </a>
        </p>
      )}
    </div>
  </section>

  <Curadoria />

  <section class="secao" aria-labelledby="regioes-titulo">
    <div class="container-site">
      <h2 id="regioes-titulo" class="mb-3">Onde atendemos</h2>
      <p class="mb-6 text-cinza-medio">Capital, ABC, Grande São Paulo e região de Jundiaí, Campinas e Atibaia. Regiões mais atendidas:</p>
      <RegionGrid regioes={regioesPrioridade1} />
      <a href={href("/montador-de-moveis/")} class="mt-6 inline-block font-semibold text-primaria underline decoration-acao decoration-2 underline-offset-4">Ver todas as regiões</a>
    </div>
  </section>

  <section class="secao bg-primaria" aria-labelledby="como-funciona-titulo">
    <div class="container-site grid gap-10 md:grid-cols-2 md:gap-16">
      <div>
        <h2 id="como-funciona-titulo" class="mb-8 text-white">Como funciona</h2>
        <Steps />
      </div>
      <Conversa />
      <p class="text-white/80 md:col-span-2">{site.exibirValorMinimo && <>Serviços a partir de R$ {site.valorMinimo}. </>}O valor depende do móvel e do endereço, e você recebe o valor fechado antes de agendar. <a href={href("/orcamento/")} class="text-acao underline underline-offset-4">Entenda como o orçamento é feito</a>.</p>
    </div>
  </section>

  <Testimonials />

  <FAQ itens={faqGeral} />

  {/* Formulário desligado: o CTA final já leva ao WhatsApp, sem repetir o botão. */}
  {site.formularioAtivo && (
  <section class="secao bg-cinza" aria-label="Formulário de orçamento">
    <div class="container-site">
      <LeadForm />
    </div>
  </section>
  )}

  <CTAFinal />
</Base>
