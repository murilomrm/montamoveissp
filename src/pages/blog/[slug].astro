---
import { getCollection, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import { schemaArticle, schemaBreadcrumb } from "@/lib/seo";
import { href } from "@/lib/url";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Foto from "@/components/Foto.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import CTAFinal from "@/components/CTAFinal.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const path = `/blog/${post.id}/`;
const crumbs = [
  { nome: "Início", url: "/" },
  { nome: "Blog", url: "/blog/" },
  { nome: post.data.title, url: path },
];
const schemas = [
  schemaArticle({ titulo: post.data.title, descricao: post.data.description, url: path, imagem: post.data.ogImage }),
  schemaBreadcrumb(crumbs),
];
const outros = (await getCollection("blog"))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => a.data.ordem - b.data.ordem)
  .slice(0, 3);
---
<Base title={post.data.title} description={post.data.description} path={path} tipo="article" ogImage={post.data.ogImage} schemas={schemas}>
  <div class="container-site pt-4"><Breadcrumb itens={crumbs} /></div>
  <article class="container-site max-w-3xl py-8 md:py-12">
    <header class="mb-8">
      <h1 class="mb-3">{post.data.title}</h1>
      <p class="text-lg text-cinza-medio">{post.data.description}</p>
      {post.data.imagem && (
        <Foto nome={post.data.imagem} alt={post.data.title} largura={1200} altura={675} class="mt-6" prioridade />
      )}
    </header>
    <div class="prosa" data-base-links>
      <Content />
    </div>
    <div class="mt-8 rounded-xl bg-cinza p-6 text-center">
      <p class="mb-4 font-semibold text-primaria">Quer o valor da sua montagem?</p>
      <WhatsAppButton origem="cta" />
    </div>
  </article>
  {outros.length > 0 && (
    <section class="secao bg-cinza">
      <div class="container-site max-w-3xl">
        <h2 class="mb-4">Leia também</h2>
        <ul class="space-y-2">
          {outros.map((p) => <li><a href={href(`/blog/${p.id}/`)} class="font-medium text-primaria underline underline-offset-2">{p.data.title}</a></li>)}
        </ul>
      </div>
    </section>
  )}
  <CTAFinal />
</Base>
<script>
  // Links internos do Markdown são escritos como "/caminho/". Ajusta o prefixo quando o site roda em subpasta (github.io).
  const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
  if (base) {
    document.querySelectorAll<HTMLAnchorElement>("[data-base-links] a[href^='/']").forEach((a) => {
      const h = a.getAttribute("href")!;
      if (!h.startsWith(base + "/")) a.setAttribute("href", base + h);
    });
  }
</script>
