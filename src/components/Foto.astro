---
// Renderiza uma foto de public/img/. A fonte da verdade é src/data/fotos.json,
// gerado por scripts/importar-fotos.sh, e NÃO o sistema de arquivos.
//
// Por que não ler o disco: `fs.existsSync` depende do diretório de trabalho do processo,
// que no builder do Cloudflare não é a raiz do projeto. O build passava, as imagens subiam,
// mas toda página saía com o bloco cinza. O manifesto é determinístico em qualquer ambiente
// e ainda traz as dimensões reais, que zeram o layout shift.
//
// Ao adicionar uma foto nova, rode ./scripts/importar-fotos.sh para regerar o manifesto.
import { href } from "@/lib/url";
import fotos from "@/data/fotos.json";

interface Props {
  nome: string; // nome do arquivo sem extensão, ex.: "hero"
  alt: string;
  largura?: number; // usado só quando a foto não está no manifesto
  altura?: number;
  prioridade?: boolean; // true no hero (sem lazy)
  class?: string;
  legenda?: string;
}

const { nome, alt, largura = 1200, altura = 900, prioridade = false, class: classe = "", legenda } = Astro.props;

const manifesto = fotos as Record<string, { largura: number; altura: number; ext: string }>;
const foto = manifesto[nome];
const w = foto?.largura ?? largura;
const h = foto?.altura ?? altura;
const src = foto ? href(`/img/${nome}.${foto.ext}`) : null;
---
<figure class={classe}>
  {src ? (
    <img
      src={src}
      alt={alt}
      width={w}
      height={h}
      loading={prioridade ? "eager" : "lazy"}
      decoding={prioridade ? "sync" : "async"}
      fetchpriority={prioridade ? "high" : undefined}
      class="h-auto w-full rounded-xl object-cover"
    />
  ) : (
    <div
      role="img"
      aria-label={alt}
      class="w-full rounded-xl bg-gray-200"
      style={`aspect-ratio: ${w} / ${h}`}
    ></div>
  )}
  {legenda && <figcaption class="mt-2 text-sm text-cinza-medio">{legenda}</figcaption>}
</figure>
