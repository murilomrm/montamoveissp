---
import { site } from "@/data/site";
// Fluxo em 4 etapas, numerado porque é uma sequência de verdade.
// Nenhum passo promete prazo de resposta, garantia ou cita forma de pagamento (ver site.ts).
const passos = [
  { titulo: "Mande a lista", texto: "Pelo WhatsApp: quais móveis, o bairro e o andar. Foto da caixa ou do projeto já resolve." },
  { titulo: "Receba o valor", texto: "A gente confere o que o serviço exige e retorna com o valor fechado para aquela lista." },
  { titulo: "Aprove e agende", texto: `Você escolhe o dia. Atendemos de ${site.horario.toLowerCase()}.` },
  { titulo: "Confira no fim", texto: "Portas, gavetas e nivelamento testados com o montador ainda no local." },
];
---
<ol class="flex flex-col">
  {passos.map((p, i) => (
    <li class="flex gap-4 border-t border-white/20 py-5 first:border-t-0 first:pt-0">
      <span class="w-7 shrink-0 font-[family-name:var(--font-titulo)] text-2xl font-bold leading-none text-acao" aria-hidden="true">{i + 1}.</span>
      <span>
        <h3 class="mb-1 text-white">{p.titulo}</h3>
        <p class="text-white/80">{p.texto}</p>
      </span>
    </li>
  ))}
</ol>
