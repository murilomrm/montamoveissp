---
import { href } from "@/lib/url";
// Só existe quando há GTM configurado. Sem GTM não há cookie de terceiros para consentir.
const gtmId = import.meta.env.PUBLIC_GTM_ID?.trim() || "";
---
{gtmId && (
  <div id="cookie-banner" hidden class="fixed inset-x-0 bottom-0 z-50 border-t border-gray-200 bg-white p-4 shadow-lg" role="dialog" aria-live="polite" aria-label="Aviso de cookies">
    <div class="container-site flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm">
        Usamos cookies para medir visitas e anúncios. Você pode recusar sem perder nada do site.
        <a href={href("/politica-de-privacidade/")} class="underline">Política de privacidade</a>
      </p>
      <div class="flex gap-2">
        <button type="button" id="cookie-recusar" class="btn btn-borda text-sm">Recusar</button>
        <button type="button" id="cookie-aceitar" class="btn btn-primaria text-sm">Aceitar</button>
      </div>
    </div>
  </div>
  <script is:inline>
    (function () {
      var banner = document.getElementById("cookie-banner");
      if (!banner) return;
      if (/(?:^|; )mm_consent=(granted|denied)/.test(document.cookie)) return;
      banner.hidden = false;
      function gravar(valor) {
        document.cookie = "mm_consent=" + valor + "; max-age=15552000; path=/; SameSite=Lax";
        banner.hidden = true;
      }
      document.getElementById("cookie-aceitar").addEventListener("click", function () {
        gravar("granted");
        if (window.gtag) window.gtag("consent", "update", { ad_storage: "granted", ad_user_data: "granted", ad_personalization: "granted", analytics_storage: "granted" });
        if (window.__mmCarregarGtm) window.__mmCarregarGtm();
      });
      document.getElementById("cookie-recusar").addEventListener("click", function () { gravar("denied"); });
    })();
  </script>
)}
