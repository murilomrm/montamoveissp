---
// Ficha rápida: o que o cliente quer saber antes de chamar. Só fatos de site.ts.
// Sem promessa de garantia, de prazo de resposta ou de forma de pagamento.
import { site } from "@/data/site";
const linhas = [
  { rotulo: "Atende", valor: "Capital, ABC e Grande SP" },
  { rotulo: "Horário", valor: site.horario },
  { rotulo: "Quem monta", valor: "Montadores da rede, com ferramenta própria" },
  { rotulo: "Como pedir", valor: "Fotos e bairro pelo WhatsApp. Valor fechado antes de agendar" },
];
---
<dl class="grid grid-cols-[auto_1fr] gap-x-5 gap-y-2 border-t-2 border-primaria pt-4 text-[0.95rem]">
  {linhas.map((l) => (
    <>
      <dt class="font-[family-name:var(--font-titulo)] text-lg font-semibold leading-snug text-primaria">{l.rotulo}</dt>
      <dd class="leading-snug text-texto">{l.valor}</dd>
    </>
  ))}
</dl>
