---
// Sem promessa de garantia, de prazo de resposta ou de forma de pagamento (ver site.ts).
const provas = [
  { titulo: "Orçamento sem compromisso", texto: "Você aprova o valor antes de agendar" },
  { titulo: "Montadores verificados", texto: "Ferramenta própria e referência checada" },
  { titulo: "Kit, planejado e escritório", texto: "Montagem, desmontagem e instalação" },
];
---
<ul class="grid gap-3 sm:grid-cols-3">
  {provas.map((p) => (
    <li class="rounded-lg border border-gray-200 bg-white p-4">
      <strong class="block text-primaria">{p.titulo}</strong>
      <span class="text-sm text-cinza-medio">{p.texto}</span>
    </li>
  ))}
</ul>
