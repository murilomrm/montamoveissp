---
import { href } from "@/lib/url";
import type { Servico } from "@/data/types";

interface Props { servico: Servico }
const { servico } = Astro.props;
---
<a href={href(`/${servico.slug}/`)} class="group flex items-start gap-4 border-b border-gray-300 py-5 hover:bg-cinza/60">
  <span class="flex-1">
    <h3 class="mb-1 group-hover:underline group-hover:decoration-acao group-hover:decoration-4 group-hover:underline-offset-4">{servico.nome}</h3>
    <span class="block text-[0.95rem] text-cinza-medio">{servico.resumo}</span>
  </span>
  <svg class="mt-1.5 h-5 w-5 shrink-0 text-primaria" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 4l6 6-6 6"/></svg>
</a>
