---
import { linkWhatsapp } from "@/lib/whatsapp";
import IconeWhatsapp from "./IconeWhatsapp.astro";

interface Props { servico?: string; regiao?: string }
const { servico, regiao } = Astro.props;
const url = linkWhatsapp({ servico, regiao });
---
<a
  id="wa-float"
  href={url}
  target="_blank"
  rel="noopener"
  data-wa
  data-origem="flutuante"
  data-servico={servico ?? ""}
  data-regiao={regiao ?? ""}
  class="fixed bottom-4 right-4 z-40 flex h-14 items-center gap-2 rounded-full bg-whatsapp px-4 text-white shadow-lg transition-opacity duration-150 hover:bg-whatsapp-escuro md:h-14 md:px-5"
  aria-label="Pedir orçamento no WhatsApp"
>
  <IconeWhatsapp class="h-7 w-7" />
  <span class="hidden font-semibold md:inline">Orçamento</span>
</a>
<script>
  // Esconde o botão flutuante enquanto um formulário de lead estiver visível, para não cobrir o botão de envio.
  const flutuante = document.getElementById("wa-float");
  const forms = document.querySelectorAll<HTMLElement>("form[data-lead-form]");
  if (flutuante && forms.length && "IntersectionObserver" in window) {
    const visiveis = new Set<Element>();
    const obs = new IntersectionObserver((entries) => {
      for (const e of entries) e.isIntersecting ? visiveis.add(e.target) : visiveis.delete(e.target);
      flutuante.style.opacity = visiveis.size ? "0" : "1";
      flutuante.style.pointerEvents = visiveis.size ? "none" : "auto";
    }, { threshold: 0.15 });
    forms.forEach((f) => obs.observe(f));
  }
</script>
