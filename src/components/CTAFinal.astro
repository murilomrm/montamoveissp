---
import { site } from "@/data/site";
import WhatsAppButton from "./WhatsAppButton.astro";

interface Props { servico?: string; regiao?: string; titulo?: string }
const { servico, regiao, titulo = "Mande a lista e receba o valor" } = Astro.props;
---
<section class="bg-primaria py-14 text-white md:py-20" aria-labelledby="cta-final-titulo">
  <div class="container-site">
    <div>
      <h2 id="cta-final-titulo" class="mb-3 text-white">{titulo}</h2>
      <p class="mb-6 max-w-[48ch] text-white/80">Quais móveis, o bairro e o andar. Uma foto da caixa ou do projeto já ajuda. O atendimento é todo pelo WhatsApp.</p>
      <WhatsAppButton origem="cta" servico={servico} regiao={regiao} class="text-lg" />
    </div>
  </div>
</section>
