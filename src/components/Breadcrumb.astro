---
import { href } from "@/lib/url";
import type { Crumb } from "@/lib/seo";

interface Props { itens: Crumb[] }
const { itens } = Astro.props;
---
<nav aria-label="Você está em" class="text-sm text-cinza-medio">
  <ol class="flex flex-wrap items-center gap-1">
    {itens.map((c, i) => (
      <li class="flex items-center gap-1">
        {i > 0 && <span aria-hidden="true">/</span>}
        {i < itens.length - 1 ? (
          <a href={href(c.url)} class="hover:text-primaria hover:underline">{c.nome}</a>
        ) : (
          <span aria-current="page" class="text-texto">{c.nome}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
