---
import { href } from "@/lib/url";
import type { Regiao } from "@/data/types";

interface Props { regioes: Regiao[]; titulo?: string; classe?: string }
const { regioes, titulo, classe = "" } = Astro.props;
---
<div class={classe}>
  {titulo && <h3 class="mb-3">{titulo}</h3>}
  <ul class="flex flex-wrap gap-2">
    {regioes.map((r) => (
      <li>
        <a href={href(`/montador-de-moveis/${r.slug}/`)} class="inline-flex min-h-11 items-center rounded-full border border-gray-300 bg-white px-4 text-sm font-medium hover:border-primaria hover:text-primaria">
          {r.nome}
        </a>
      </li>
    ))}
  </ul>
</div>
